# Copy this file to .env (gitignored) and fill in your home WiFi
# credentials. They get baked into the firmware as the first-boot NVS
# default (see load_env.py, include/network.h) - the device tries this
# network before falling back to its own "NoiseLight" AP.
#
# Once you save WiFi settings via the device's web UI, the NVS-stored
# value always wins over this default - this file only matters for the
# very first boot of a freshly flashed device.

WIFI_SSID=
WIFI_PASSWORD=
